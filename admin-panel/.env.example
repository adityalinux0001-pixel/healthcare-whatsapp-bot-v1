# Copy this file to .env
ENVIRONMENT=development

# Same PostgreSQL database used by the main chatbot.
DATABASE_URL=postgresql+asyncpg://botuser:password@localhost:5432/dietbot

# Same Redis instance used by the main project (used only for login rate limiting).
REDIS_URL=redis://localhost:6379/0

# Single admin account.
ADMIN_PHONE=9753536539
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH

# Long random secret. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# 8 hours.
ADMIN_SESSION_MAX_AGE=28800

# Local development: false. Production behind HTTPS: true.
ADMIN_COOKIE_SECURE=false

# Admin UI port.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8001
