ENVIRONMENT=production
DOMAIN=your-domain.example.com

# --- Postgres ---
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dietbot
# Hostname "postgres" matches the docker-compose service name.
# For local (non-docker) dev, change it to "localhost".
DATABASE_URL=postgresql+asyncpg://botuser:change_me@postgres:5432/dietbot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Meta WhatsApp Cloud API (direct, no BSP) ---
WHATSAPP_TOKEN=your_permanent_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_you_like
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_CHAT=gemini-2.5-flash-lite
GEMINI_MODEL_DIET_PLAN=gemini-2.5-flash

# --- Knowledge base ---
KNOWLEDGE_TOP_K_DIET=10
KNOWLEDGE_TOP_K_QA=8
KNOWLEDGE_TOP_K_EXERCISE=5
KNOWLEDGE_AUTHORITATIVE_QUERY_EXPANSIONS=4
KNOWLEDGE_MIN_AUTHORITATIVE_RESULTS=2
KNOWLEDGE_MIN_SIMILARITY=0.25
KNOWLEDGE_MIN_AUTHORITATIVE_SCORE=0.50

# --- Razorpay ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Business config ---
SUBSCRIPTION_PRICE_INR=499
SUBSCRIPTION_DAYS=21

# --- Production safety ---
REQUIRE_HEALTH_CONSENT=true
CONVERSATION_LOCK_SECONDS=900
WORKER_HEARTBEAT_REQUIRED=true
WORKER_HEARTBEAT_KEY=dietbot:worker:heartbeat

# DEV/TEST ONLY; ignored when ENVIRONMENT=production
BYPASS_SUBSCRIPTION=false
